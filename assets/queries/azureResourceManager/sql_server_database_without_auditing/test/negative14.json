{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "sqlServerName": {
      "type": "String",
      "defaultValue": "contoso-sql-server"
    },
    "sqlDatabaseName": {
      "type": "String",
      "defaultValue": "contoso-db"
    },
    "sqlLocation": {
      "type": "String",
      "defaultValue": "eastus2"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2022-05-01-preview",
      "name": "[parameters('sqlServerName')]",
      "location": "[parameters('sqlLocation')]",
      "properties": {
        "administratorLogin": "contosoadmin"
      },
      "resources": [
        {
          "type": "databases",
          "apiVersion": "2022-05-01-preview",
          "name": "[parameters('sqlDatabaseName')]",
          "location": "[parameters('sqlLocation')]",
          "dependsOn": [
            "[parameters('sqlServerName')]"
          ],
          "properties": {
            "collation": "SQL_Latin1_General_CP1_CI_AS"
          }
        }
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases/auditingSettings",
      "apiVersion": "2022-05-01-preview",
      "name": "[format('{0}/{1}/Default', parameters('sqlServerName'), parameters('sqlDatabaseName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers/databases', parameters('sqlServerName'), parameters('sqlDatabaseName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "isAzureMonitorTargetEnabled": true,
        "retentionDays": 180
      }
    }
  ]
}
